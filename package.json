    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "eslint": "9.39.5",
    "rimraf": "5.0.10",
    "glob": "10.4.5"
