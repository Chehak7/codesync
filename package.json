{
  "name": "codesync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n next,collaboration -c cyan,magenta \"npm:dev:next\" \"npm:dev:collaboration:optional\"",
    "dev:next": "next dev",
    "dev:collaboration": "node --env-file-if-exists=.env.local --import tsx collaboration/server.mts",
    "dev:collaboration:optional": "node --env-file-if-exists=.env.local --import tsx scripts/dev-collaboration.mjs",
    "build": "next build && npm run build:collaboration",
    "build:collaboration": "tsc -p tsconfig.collaboration.json",
    "start": "next start",
    "start:collaboration": "node --env-file-if-exists=.env.local dist-collaboration/server.mjs",
    "lint": "eslint app components lib --ext .ts,.tsx",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
